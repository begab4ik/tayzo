# Бот: вебхуки и healthcheck
{$DOMAIN} {
    handle /webhooks/* {
        reverse_proxy bot:8080
    }
    handle /health {
        reverse_proxy bot:8080
    }
    handle {
        respond "Tayzo" 404
    }
    log {
        output file /data/access.log {
            roll_size 10mb
            roll_keep 3
        }
    }
}

# Сайт tayzo.uz (статика из ./site)
{$SITE_DOMAIN:tayzo.uz}, www.{$SITE_DOMAIN:tayzo.uz} {
    @www host www.{$SITE_DOMAIN:tayzo.uz}
    redir @www https://{$SITE_DOMAIN:tayzo.uz}{uri} permanent

    # API Mini App и вебхуки — в бота
    handle /api/* {
        header Cache-Control "no-store"
        reverse_proxy bot:8080
    }
    handle /webhooks/* {
        reverse_proxy bot:8080
    }
    # статика сайта и мини-приложения
    handle {
        root * /srv/site
        encode gzip zstd
        header {
            Cache-Control "public, max-age=600"
            X-Content-Type-Options nosniff
            Referrer-Policy strict-origin-when-cross-origin
        }
        header /brand/* Cache-Control "public, max-age=604800"
        file_server
    }
    log {
        output file /data/site-access.log {
            roll_size 10mb
            roll_keep 3
        }
    }
}

# vybe.uz — братские вайбы (статика из ./vybe)
vybe.uz, www.vybe.uz {
    @www host www.vybe.uz
    redir @www https://vybe.uz{uri} permanent
    root * /srv/vybe
    encode gzip zstd
    header {
        Cache-Control "public, max-age=600"
        X-Content-Type-Options nosniff
    }
    header /photos/* Cache-Control "public, max-age=604800"
    file_server
}
