# ===================== Tayzo — обычные настройки =====================
# Скопируй в .env. Все токены/секреты — в tokens.env (см. SETUP_TOKENS.md)

SUPPORT_USERNAME=tayzo_support

# --- Домен сервера (для HTTPS и вебхуков Click) ---
# Caddy сам получит сертификат. В Click указывай https://<DOMAIN>/webhooks/click
DOMAIN=bot.example.uz
WEBHOOK_HOST=https://bot.example.uz

# --- База данных (для docker compose не менять) ---
DATABASE_URL=postgresql+asyncpg://tayzo:tayzo@localhost:5432/tayzo
REDIS_URL=redis://localhost:6379/0

API_HOST=0.0.0.0
API_PORT=8080

# --- Режим доставки ---
# false = автооплата через Fragment (если токены в tokens.env заполнены)
# true  = все заказы падают админу в ручную очередь
MANUAL_FULFILLMENT=false

TIMEZONE=Asia/Tashkent
LOG_LEVEL=INFO
